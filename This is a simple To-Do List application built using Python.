# Simple To-Do List App in Python

tasks = []

def show_menu():
    print("\n--- My To-Do List ---")
    print("1. Add Task")
    print("2. View Tasks")
    print("3. Delete Task")
    print("4. Exit")

while True:
    show_menu()
    choice = input("Choose an option (1-4): ")

    if choice == "1":
        task = input("Enter your task: ")
        tasks.append(task)
        print("Task Added Successfully!")

    elif choice == "2":
        print("\nYour Tasks:")
        if len(tasks) == 0:
            print("No tasks yet!")
        else:
            for i, t in enumerate(tasks, 1):
                print(f"{i}. {t}")

    elif choice == "3":
        print("\nYour Tasks:")
        for i, t in enumerate(tasks, 1):
            print(f"{i}. {t}")
        num = int(input("Which task number to delete? "))
        tasks.pop(num - 1)
        print("Task Deleted!")

    elif choice == "4":
        print("Thank you! Bye!")
        break
    else:
        print("Please choose 1 to 4 only")
